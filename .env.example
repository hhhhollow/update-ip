# =================================================================
# Bark 推送配置
# =================================================================
# Bark 设备 Key (在 iOS Bark App 中获取，例如 https://api.day.app/YOUR_KEY/ 中的 YOUR_KEY)
BARK_KEY=

# Bark 服务器地址 (默认官方服务器，自建服务器填写自建地址)
BARK_SERVER=https://api.day.app

# 推送分组名称
BARK_GROUP=IP-Monitor

# 推送声音 (可选: minuet, bell, alarm, electronic, glass, horn 等)
BARK_SOUND=minuet

# 推送图标 (可选，支持图片 URL)
BARK_ICON=https://cdn-icons-png.flaticon.com/512/2920/2920244.png

# 通知级别 (active: 立即亮屏 / timeSensitive: 时效性通知 / passive: 静默)
BARK_LEVEL=active

# =================================================================
# 监控轮询配置
# =================================================================
# 检查网络 IP 间隔时间 (单位: 秒，默认 60 秒)
CHECK_INTERVAL=60

# 监控启动时是否发送一条确认通知 (true / false)
NOTIFY_ON_START=true

# 本地 IP 缓存路径 (默认存储在当前目录 .ip_cache.json)
CACHE_FILE=.ip_cache.json

# 请求超时时间 (秒)
REQUEST_TIMEOUT=10.0
