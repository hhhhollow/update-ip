# Bark 推送配置
BARK_KEY=
BARK_SERVER=https://api.day.app
BARK_GROUP=IP-Monitor
BARK_SOUND=minuet
BARK_ICON=https://cdn-icons-png.flaticon.com/512/2920/2920244.png
BARK_LEVEL=active

# 监控配置
# 检查间隔（秒），必须 >= 1
CHECK_INTERVAL=60

# 地址族：4 / 6 / any。默认 4，避免探测源返回不同地址族导致误报。
IP_VERSION=4

# 国内 IP 探测源：应在代理软件的规则模式下走 DIRECT。
# Pydantic 的列表环境变量使用 JSON 数组格式；不填写时使用内置默认值。
# DOMESTIC_IP_PROVIDERS=["https://4.ipw.cn","https://6.ipw.cn","https://cip.cc","http://myip.ipip.net"]

# 国外/代理出口 IP 探测源。保留原变量名 IP_PROVIDERS 以兼容旧配置。
# IP_PROVIDERS=["https://api.ipify.org","https://icanhazip.com","https://ifconfig.me/ip"]

NOTIFY_ON_START=true
CACHE_FILE=.ip_cache.json
REQUEST_TIMEOUT=10.0
MAX_RETRIES_PER_PROVIDER=2
